# Conexao com o banco de dados (PostgreSQL).
#
# Local: subimos o Postgres do projeto via Docker em porta 5433
# (5432 fica reservada para outros projetos no mesmo host).
#
#   docker run -d --name figurinoapp-db \
#     -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=figurinoapp \
#     -p 5433:5432 postgres:16-alpine
#
# Copie este arquivo para .env.server e ajuste se necessario.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/figurinoapp"
